#!/usr/bin/env bash
# ndevs — list and edit devices registered in devices.db
#
# Usage:
#   ndevs                        list all devices
#   ndevs --edit <alias>         interactively edit alias/ip/user/port
#   ndevs --rename <old> <new>   rename alias (cleans known_hosts if IP matches)
#   ndevs --remove <alias>       remove device entry + prune known_hosts
#   ndevs --update-ip <alias> <newip>  update IP, auto-clean known_hosts
#
# Exit codes:
#   0 — always for list (empty db is not an error)
#   1 — argument error or alias not found for edit/remove operations

set -eu

_self="$0"
case "$_self" in */*) ;; *) _self="$(command -v "$_self")" ;; esac
if _real="$(readlink -f "$_self" 2>/dev/null)" && [ -n "$_real" ]; then
    _self="$_real"
else
    while [ -L "$_self" ]; do
        _link="$(readlink "$_self")"
        case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
    done
fi
_bindir="$(cd "$(dirname "$_self")" && pwd -P)"
. "$_bindir/_bootstrap"
_source_mods util.sh identity.sh

# Internal nssh/nscp calls below never prompt for a password; ssh_config's
# automation Match block enforces BatchMode yes so a missing key fails fast.
export NOEMAP_SSH_ROLE=automation

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_require_db() {
    if [ ! -f "$DB" ]; then
        printf '[INFO] no devices registered\n' >&2
        exit 0
    fi
}

_has_data() {
    awk -F'|' '
        /^[[:space:]]*$/ { next }
        /^#/             { next }
        NF >= 2          { found=1; exit }
        END              { exit !found }
    ' "$DB" 2>/dev/null && echo yes || echo no
}

_print_table() {
    awk -F'|' '
        /^[[:space:]]*$/ { next } /^#/ { next }
        NF >= 2 {
            port = ($4 == "" ? "22" : $4)
            if(length($1)>w1) w1=length($1)
            if(length($2)>w2) w2=length($2)
            if(length($3)>w3) w3=length($3)
            rows[NR]=$1 "|" $2 "|" $3 "|" port
        }
        END {
            w1=(w1>5?w1:5); w2=(w2>4?w2:4); w3=(w3>4?w3:4)
            fmt="%-" w1 "s  %-" w2 "s  %-" w3 "s  %s\n"
            dash1=substr("----------------------------------------",1,w1)
            dash2=substr("----------------------------------------",1,w2)
            dash3=substr("----------------------------------------",1,w3)
            printf fmt, "ALIAS","IP","USER","PORT"
            printf fmt, dash1, dash2, dash3, "----"
            for(i=1;i<=NR;i++) {
                if(!(i in rows)) continue
                n=split(rows[i],a,"|")
                printf fmt, a[1],a[2],a[3],a[4]
            }
        }
    ' "$DB"
}

# _find_alias alias — prints the raw db line for the alias, or empty string.
_find_alias() {
    _a="$1"
    awk -F'|' -v a="$_a" '
        /^[[:space:]]*$/ { next }
        /^#/             { next }
        $1 == a          { print; exit }
    ' "$DB" 2>/dev/null
}

_alias_exists() {
    _row="$(_find_alias "$1")"
    [ -n "$_row" ]
}

# _snapshot_db alias — save a timestamped copy of devices.db under the user
# state dir (NEVER in the repo: install.sh only seeds state/devices.db once
# and never overwrites). Used before any destructive write so --rollback can
# restore. Prints the snapshot path.
_snapshot_db() {
    _snap_alias="$1"
    _snap_dir="$DATA/state/snapshots"
    mkdir -p "$_snap_dir"
    _snap_path="$_snap_dir/${_snap_alias}.bak"
    [ -f "$DB" ] && cp -f "$DB" "$_snap_path"
    printf '%s\n' "$_snap_path"
}

# _verify_ssh ip port — returns 0 if the SSH port accepts a TCP connection.
# Uses nc -z with a 5s timeout. Best-effort: absence of nc is not fatal.
_verify_ssh() {
    _vs_ip="$1"; _vs_port="${2:-22}"
    has_cmd nc || return 0
    nc -z -w5 "$_vs_ip" "$_vs_port" >/dev/null 2>&1
}

# _prompt_field label current — prompts user; returns new value or current if empty.
_prompt_field() {
    _label="$1"
    _current="$2"
    printf '  %s [%s]: ' "$_label" "$_current" >&2
    read -r _val </dev/tty || _val=""
    _val="$(printf '%s' "$_val" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [ -z "$_val" ] && printf '%s\n' "$_current" || printf '%s\n' "$_val"
}

# _rewrite_db awk_program — runs awk on DB preserving comment/blank lines,
# writes result to a temp file, then replaces DB atomically.
# The awk program receives data lines only; comment/blank lines are passed through.
_rewrite_db() {
    _prog="$1"
    _tmp_db="$(mktemp "${TMPDIR:-/tmp}/ndevs.XXXXXX")"
    awk -F'|' -v prog=1 "
        /^[[:space:]]*\$/ { print; next }
        /^#/              { print; next }
        ${_prog}
    " "$DB" > "$_tmp_db"
    mv -f "$_tmp_db" "$DB"
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

_cmd_list() {
    _require_db
    if [ "$(_has_data)" = "no" ]; then
        printf '[INFO] no devices registered\n' >&2
        exit 0
    fi
    _print_table
}

_cmd_edit() {
    [ $# -ge 1 ] || { printf 'usage: ndevs --edit <alias>\n' >&2; exit 1; }
    _alias="$1"
    _require_db

    _row="$(_find_alias "$_alias")"
    [ -n "$_row" ] || { log ERROR "unknown alias: '$_alias'"; exit 1; }

    _cur_alias="$(printf '%s\n' "$_row" | cut -d'|' -f1)"
    _cur_ip="$(printf '%s\n'    "$_row" | cut -d'|' -f2)"
    _cur_user="$(printf '%s\n'  "$_row" | cut -d'|' -f3)"
    _cur_port="$(printf '%s\n'  "$_row" | cut -d'|' -f4)"
    [ -n "$_cur_port" ] || _cur_port=22

    printf '\nEditing device: %s\n' "$_alias" >&2
    _new_alias="$(_prompt_field "alias"  "$_cur_alias")"
    _new_ip="$(_prompt_field    "ip"     "$_cur_ip")"
    _new_user="$(_prompt_field  "user"   "$_cur_user")"
    _new_port="$(_prompt_field  "port"   "$_cur_port")"

    # If IP changed, clean known_hosts of old IP before reconnecting
    known_hosts_sync_device "$_cur_alias" "$_cur_ip" "$_new_ip"

    # Rewrite db: replace only the matching data line; preserve comments/blanks
    _tmp_db="$(mktemp "${TMPDIR:-/tmp}/ndevs.XXXXXX")"
    awk -F'|' \
        -v old="$_cur_alias" \
        -v na="$_new_alias" -v ni="$_new_ip" \
        -v nu="$_new_user"  -v np="$_new_port" '
        /^[[:space:]]*$/ { print; next }
        /^#/             { print; next }
        $1 == old        { printf "%s|%s|%s|%s\n", na, ni, nu, np; next }
        { print }
    ' "$DB" > "$_tmp_db"
    mv -f "$_tmp_db" "$DB"
    log OK "updated '$_alias' → alias=$_new_alias ip=$_new_ip user=$_new_user port=$_new_port"
}

_cmd_rename() {
    [ $# -ge 2 ] || { printf 'usage: ndevs --rename <old> <new>\n' >&2; exit 1; }
    _old="$1"; _new="$2"
    _require_db
    _alias_exists "$_old" || { log ERROR "unknown alias: '$_old'"; exit 1; }

    _tmp_db="$(mktemp "${TMPDIR:-/tmp}/ndevs.XXXXXX")"
    awk -F'|' -v old="$_old" -v new="$_new" '
        /^[[:space:]]*$/ { print; next }
        /^#/             { print; next }
        $1 == old        { printf "%s|%s|%s|%s\n", new, $2, $3, $4; next }
        { print }
    ' "$DB" > "$_tmp_db"
    mv -f "$_tmp_db" "$DB"
    log OK "renamed '$_old' → '$_new'"
}

_cmd_remove() {
    [ $# -ge 1 ] || { printf 'usage: ndevs --remove <alias> [alias...]\n' >&2; exit 1; }
    _require_db

    for _alias in "$@"; do
        _row="$(_find_alias "$_alias")"
        if [ -z "$_row" ]; then
            log WARN "unknown alias: '$_alias' — skipping"
            continue
        fi
        _ip="$(printf '%s\n' "$_row" | cut -d'|' -f2)"

        _tmp_db="$(mktemp "${TMPDIR:-/tmp}/ndevs.XXXXXX")"
        awk -F'|' -v a="$_alias" '
            /^[[:space:]]*$/ { print; next }
            /^#/             { print; next }
            $1 == a          { next }
            { print }
        ' "$DB" > "$_tmp_db"
        mv -f "$_tmp_db" "$DB"

        known_hosts_remove_ip "$_ip"
        log OK "removed '$_alias' ($_ip) and cleaned known_hosts"
    done
}

_cmd_resetall() {
    rm -f "$DB" "$DATA/state/hosts.db" "$DATA/state/cache.env" "$KNOWN_HOSTS"
    : > "$DB"
    log OK "reset complete: devices.db + known_hosts + hosts.db + cache cleared"
}

_cmd_update_ip() {
    [ $# -ge 2 ] || { printf 'usage: ndevs --update-ip <alias> <newip>\n' >&2; exit 1; }
    _alias="$1"; _new_ip="$2"
    _require_db

    _row="$(_find_alias "$_alias")"
    [ -n "$_row" ] || { log ERROR "unknown alias: '$_alias'"; exit 1; }
    _old_ip="$(printf '%s\n' "$_row" | cut -d'|' -f2)"

    # snapshot before write so --rollback can restore
    _snap="$(_snapshot_db "$_alias")"

    known_hosts_sync_device "$_alias" "$_old_ip" "$_new_ip"

    _tmp_db="$(mktemp "${TMPDIR:-/tmp}/ndevs.XXXXXX")"
    awk -F'|' -v a="$_alias" -v ni="$_new_ip" '
        /^[[:space:]]*$/ { print; next }
        /^#/             { print; next }
        $1 == a          { printf "%s|%s|%s|%s\n", $1, ni, $3, $4; next }
        { print }
    ' "$DB" > "$_tmp_db"
    mv -f "$_tmp_db" "$DB"
    log OK "updated '$_alias': ip $_old_ip → $_new_ip"

    if _verify_ssh "$_new_ip" "$(printf '%s\n' "$_row" | cut -d'|' -f4)"; then
        log OK "ssh check: $_new_ip reachable"
    else
        log WARN "ssh check: $_new_ip not reachable — entry kept; rollback with: ndevs --rollback $_alias"
    fi

    _propagate_db "$_new_ip"
}


_cmd_add() {
    [ $# -ge 3 ] || { printf 'usage: ndevs --add <alias> <ip> <user> [port]\n' >&2; exit 1; }
    _alias="$1"; _ip="$2"; _user="$3"; _port="${4:-22}"
    if [ -f "$DB" ] && grep -q "^${_alias}|" "$DB" 2>/dev/null; then
        log ERROR "alias '$_alias' already exists — use --edit or --rename"; exit 1
    fi

    # snapshot before any write so --rollback can restore
    _snap="$(_snapshot_db "$_alias")"

    printf '%s|%s|%s|%s\n' "$_alias" "$_ip" "$_user" "$_port" >> "$DB"
    log OK "registered '$_alias' ip=$_ip user=$_user port=$_port"

    # verify SSH reachability; the entry stays persistent either way
    if _verify_ssh "$_ip" "$_port"; then
        log OK "ssh check: $_ip:$_port reachable"
    else
        log WARN "ssh check: $_ip:$_port not reachable — entry kept; rollback with: ndevs --rollback $_alias"
    fi

    _propagate_db "$_ip"
}

# _propagate_db skip_ip — push devices.db to every registered LAN node
# (non-Tailscale IP) via nscp, skipping skip_ip and self. Best-effort:
# a node that is down is warned, never fatal. Explicit Tailscale propagation
# is done by --push-vpn, never automatically here.
_propagate_db() {
    _skip_ip="${1:-}"
    [ -f "$DB" ] || return 0
    has_cmd nscp || { log WARN "nscp not found — skipping db propagation"; return 0; }
    _remote_path="$HOME/.local/share/noemap/state/devices.db"
    awk -F'|' '/^[[:space:]]*$/{next}/^#/{next}NF>=2{print $1"|"$2}' "$DB" | \
    while IFS='|' read -r _pa _pip; do
        [ -n "$_pa" ] || continue
        [ "$_pip" = "$_skip_ip" ] && continue
        case "$_pip" in 100.*) continue ;; esac
        if nscp "$DB" "${_pa}:${_remote_path}" >/dev/null 2>&1; then
            log OK "propagated devices.db -> $_pa"
        else
            log WARN "propagate to $_pa failed (node down?) — skipped"
        fi
    done
}

# _cmd_rollback alias — restore devices.db from the user-state snapshot.
_cmd_rollback() {
    [ $# -ge 1 ] || { printf 'usage: ndevs --rollback <alias>\n' >&2; exit 1; }
    _alias="$1"
    _snap_path="$DATA/state/snapshots/${_alias}.bak"
    [ -f "$_snap_path" ] || { log ERROR "no snapshot for '$_alias' at $_snap_path"; exit 1; }
    cp -f "$_snap_path" "$DB"
    log OK "rolled back devices.db from snapshot '$_alias'"
}

# _cmd_push_vpn — propagate devices.db to all Tailscale (100.*) nodes via nscp.
# Explicit command, never automatic.
_cmd_push_vpn() {
    _require_db
    has_cmd nscp || { log ERROR "nscp not found"; exit 1; }
    _remote_path="$HOME/.local/share/noemap/state/devices.db"
    awk -F'|' '/^[[:space:]]*$/{next}/^#/{next}NF>=2{print $1"|"$2}' "$DB" | \
    while IFS='|' read -r _pa _pip; do
        [ -n "$_pa" ] || continue
        case "$_pip" in 100.*) ;; *) continue ;; esac
        if nscp "$DB" "${_pa}:${_remote_path}" >/dev/null 2>&1; then
            log OK "pushed devices.db -> $_pa ($_pip)"
        else
            log WARN "push to $_pa ($_pip) failed — skipped"
        fi
    done
}

# _distribute_registry -- push registry.db to every known node via nssh,
# skipping self. Called after every registry change so identity is never stale.
_distribute_registry() {
    [ -f "$REGISTRY_DB" ] || return 0
    has_cmd nssh || { log WARN "nssh not found -- registry not distributed"; return 0; }
    _remote_reg="$HOME/.local/share/noemap/state/registry.db"
    [ -f "$DB" ] || return 0
    # Skip self by local IP (MY_IP if exported, else any 127.* / own row).
    _my_ip="${MY_IP:-}"
    _my_alias="$(node_alias 2>/dev/null || printf '')"
    awk -F'|' '/^[[:space:]]*$/{next}/^#/{next}NF>=2{print $1"|"$2}' "$DB" | \
    while IFS='|' read -r _na _nip; do
        [ -n "$_na" ] || continue
        [ "$_na" = "$_my_alias" ] && continue
        if command -v is_local_ip >/dev/null 2>&1 && is_local_ip "$_nip"; then continue; fi
        case "$_nip" in 127.*|localhost) continue ;; esac
        if nssh "$_na" "mkdir -p ~/.local/share/noemap/state && cat > $_remote_reg" < "$REGISTRY_DB" >/dev/null 2>&1; then
            log OK "registry -> $_na"
        else
            log WARN "registry to $_na failed (node down?) -- skipped"
        fi
    done
}

# _cmd_node_set -- set THIS device's canonical identity in the master registry.
# usage: ndevs --node-set <alias> [user] [port]
_cmd_node_set() {
    [ $# -ge 1 ] || { printf 'usage: ndevs --node-set <alias> [user] [port]\n' >&2; exit 1; }
    _alias="$1"
    # Default user is 'u' (Android user name is irrelevant). If not passed and
    # stdin is a tty, prompt with 'u' as the suggested default (Enter accepts).
    if [ -n "${2:-}" ]; then
        _user="$2"
    elif [ -t 0 ]; then
        printf '  user [u]: ' >&2
        read -r _user </dev/tty || _user=""
        [ -n "$_user" ] || _user="u"
    else
        _user="u"
    fi
    _port="${3:-8022}"
    _nid="$(node_id)"
    [ -n "$_nid" ] || { log ERROR "could not compute node id"; exit 1; }
    mkdir -p "$(dirname "$REGISTRY_DB")"
    [ -f "$REGISTRY_DB" ] || : > "$REGISTRY_DB"
    _tmp="$(mktemp "${TMPDIR:-/tmp}/reg.XXXXXX")"
    awk -F'|' -v id="$_nid" '/^[[:space:]]*$/{next}/^#/{next}$1!=id{print}' "$REGISTRY_DB" > "$_tmp"
    printf '%s|%s|%s|%s\n' "$_nid" "$_alias" "$_user" "$_port" >> "$_tmp"
    mv -f "$_tmp" "$REGISTRY_DB"
    log OK "node identity set: $_alias ($_nid) user=$_user port=$_port"
    _distribute_registry
}

# _cmd_node_add -- register ANOTHER machine's identity by explicit node-id.
# usage: ndevs --node-add <node-id> <alias> <user> <port>
_cmd_node_add() {
    [ $# -ge 4 ] || { printf 'usage: ndevs --node-add <node-id> <alias> <user> <port>\n' >&2; exit 1; }
    _nid="$1"; _alias="$2"; _user="$3"; _port="$4"
    mkdir -p "$(dirname "$REGISTRY_DB")"
    [ -f "$REGISTRY_DB" ] || : > "$REGISTRY_DB"
    if grep -q "^${_nid}|" "$REGISTRY_DB" 2>/dev/null; then
        log ERROR "node-id '$_nid' already registered -- use --node-set semantics or edit"; exit 1
    fi
    printf '%s|%s|%s|%s\n' "$_nid" "$_alias" "$_user" "$_port" >> "$REGISTRY_DB"
    log OK "node added: $_alias ($_nid) user=$_user port=$_port"
    _distribute_registry
}

# _cmd_nodes -- list the master registry, marking which row is THIS device.
_cmd_nodes() {
    [ -f "$REGISTRY_DB" ] && [ -s "$REGISTRY_DB" ] || { log INFO "no nodes registered (use --node-set)"; return 0; }
    _me="$(node_id 2>/dev/null || printf '')"
    printf '  NODE-ID           ALIAS      USER       PORT  SELF\n'
    awk -F'|' -v me="$_me" '
        /^[[:space:]]*$/{next}/^#/{next}NF>=4{
            printf "  %-16s  %-9s  %-9s  %-4s  %s\n",$1,$2,$3,$4,($1==me?"<-- this":"")
        }' "$REGISTRY_DB"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
    "")                   _cmd_list ;;
    --add)                shift; _cmd_add "$@" ;;
    --edit)               shift; _cmd_edit "$@" ;;
    --rename)             shift; _cmd_rename "$@" ;;
    --remove)             shift; _cmd_remove "$@" ;;
    --update-ip)          shift; _cmd_update_ip "$@" ;;
    --rollback)           shift; _cmd_rollback "$@" ;;
    --push-vpn)           shift; _cmd_push_vpn "$@" ;;
    --node-set)           shift; _cmd_node_set "$@" ;;
    --node-add)           shift; _cmd_node_add "$@" ;;
    --nodes)              _cmd_nodes ;;
    --resetall)           _cmd_resetall ;;
    -h|--help)
        printf 'usage: ndevs\n'
        printf '       ndevs --edit <alias>\n'
        printf '       ndevs --rename <old> <new>\n'
        printf '       ndevs --remove <alias> [alias...]\n'
        printf '       ndevs --update-ip <alias> <newip>\n'
        printf '       ndevs --add <alias> <ip> <user> [port]\n'
        printf '       ndevs --rollback <alias>\n'
        printf '       ndevs --push-vpn <alias>\n'
        printf '       ndevs --node-set <alias> [user] [port]\n'
        printf '       ndevs --node-add <node-id> <alias> <user> <port>\n'
        printf '       ndevs --nodes\n'
        printf '       ndevs --resetall\n'
        ;;
    *)
        printf '[ERROR] unknown option: %s\n' "$1" >&2
        exit 1
        ;;
esac
