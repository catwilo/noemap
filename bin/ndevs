#!/usr/bin/env bash
# ndevs — list and edit devices registered in devices.db
#
# Usage:
#   ndevs                        list all devices
#   ndevs --edit <alias>         interactively edit alias/ip/user/port
#   ndevs --rename <old> <new>   rename alias (cleans known_hosts if IP matches)
#   ndevs --remove <alias>       remove device entry + prune known_hosts
#   ndevs --update-ip <alias> <newip>  update IP, auto-clean known_hosts
#
# Exit codes:
#   0 — always for list (empty db is not an error)
#   1 — argument error or alias not found for edit/remove operations

set -eu

_self="$0"
case "$_self" in */*) ;; *) _self="$(command -v "$_self")" ;; esac
if _real="$(readlink -f "$_self" 2>/dev/null)" && [ -n "$_real" ]; then
    _self="$_real"
else
    while [ -L "$_self" ]; do
        _link="$(readlink "$_self")"
        case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
    done
fi
_bindir="$(cd "$(dirname "$_self")" && pwd -P)"
. "$_bindir/_bootstrap"
_source_mods util.sh identity.sh blockdb.sh

# Internal nssh/nscp calls below never prompt for a password; ssh_config's
# automation Match block enforces BatchMode yes so a missing key fails fast.
export NOEMAP_SSH_ROLE=automation

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_require_db() {
    if [ ! -f "$DB" ]; then
        printf '[INFO] no devices registered\n' >&2
        exit 0
    fi
}

_has_data() {
    [ -s "$DB" ] && echo yes || echo no
}

_print_table() {
    _pt_aliases="$(awk '
        BEGIN { RS=""; FS="\n" }
        {
            for (i = 1; i <= NF; i++) {
                colon = index($i, ":")
                if (colon == 0) continue
                fk = substr($i, 1, colon - 1)
                if (fk == "alias") { print substr($i, colon + 2); break }
            }
        }
    ' "$DB" 2>/dev/null)"
    [ -n "$_pt_aliases" ] || return 0

    _pt_marked="$(printf '%s\n' "$_pt_aliases" | while IFS= read -r _pa; do
        [ -n "$_pa" ] || continue
        _pblk="$(blockdb_get "$DB" alias "$_pa")"
        [ -n "$_pblk" ] || continue
        _pip="$(blockdb_field "$_pblk" ip)"
        _pu="$(blockdb_field "$_pblk" user)"
        _pp="$(blockdb_field "$_pblk" port)"
        [ -n "$_pp" ] || _pp=22
        if command -v is_local_ip >/dev/null 2>&1 && is_local_ip "$_pip"; then
            printf '%s|%s|%s|%s|%s\n' "$_pa" "$_pip" "$_pu" "$_pp" "<-- this"
        else
            printf '%s|%s|%s|%s|%s\n' "$_pa" "$_pip" "$_pu" "$_pp" ""
        fi
    done)"
    [ -n "$_pt_marked" ] || return 0
    printf '%s\n' "$_pt_marked" | awk -F'|' '
        {
            if(length($1)>w1) w1=length($1)
            if(length($2)>w2) w2=length($2)
            if(length($3)>w3) w3=length($3)
            rows[NR]=$1 "|" $2 "|" $3 "|" $4 "|" $5
        }
        END {
            w1=(w1>5?w1:5); w2=(w2>4?w2:4); w3=(w3>4?w3:4)
            fmt="%-" w1 "s  %-" w2 "s  %-" w3 "s  %-6s  %s\n"
            dash1=substr("----------------------------------------",1,w1)
            dash2=substr("----------------------------------------",1,w2)
            dash3=substr("----------------------------------------",1,w3)
            printf fmt, "ALIAS","IP","USER","PORT","SELF"
            printf fmt, dash1, dash2, dash3, "----", "----"
            for(i=1;i<=NR;i++) {
                if(!(i in rows)) continue
                n=split(rows[i],a,"|")
                printf fmt, a[1],a[2],a[3],a[4],a[5]
            }
        }
    '
}

# _find_alias alias — prints the block for the alias, or empty string.
_find_alias() {
    blockdb_get "$DB" alias "$1"
}

_alias_exists() {
    _row="$(_find_alias "$1")"
    [ -n "$_row" ]
}

# _snapshot_db alias — save a timestamped copy of devices.db under the user
# state dir (NEVER in the repo: install.sh only seeds state/devices.db once
# and never overwrites). Used before any destructive write so --rollback can
# restore. Prints the snapshot path.
_snapshot_db() {
    _snap_alias="$1"
    _snap_dir="$DATA/state/snapshots"
    mkdir -p "$_snap_dir"
    _snap_path="$_snap_dir/${_snap_alias}.bak"
    [ -f "$DB" ] && cp -f "$DB" "$_snap_path"
    printf '%s\n' "$_snap_path"
}

# _verify_ssh moved to lib/util.sh as reachable_ssh() -- shared with ut
# distribution. Sourced via _source_mods util.sh above.

# _prompt_field label current — prompts user; returns new value or current if empty.
_prompt_field() {
    _label="$1"
    _current="$2"
    printf '  %s [%s]: ' "$_label" "$_current" >&2
    read -r _val </dev/tty || _val=""
    _val="$(printf '%s' "$_val" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [ -z "$_val" ] && printf '%s\n' "$_current" || printf '%s\n' "$_val"
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

_cmd_list() {
    _require_db
    if [ "$(_has_data)" = "no" ]; then
        printf '[INFO] no devices registered\n' >&2
        exit 0
    fi
    _print_table
}

_cmd_edit() {
    [ $# -ge 1 ] || { printf 'usage: ndevs --edit <alias>\n' >&2; exit 1; }
    _alias="$1"
    _require_db

    _row="$(_find_alias "$_alias")"
    [ -n "$_row" ] || { log ERROR "unknown alias: '$_alias'"; exit 1; }

    _cur_alias="$(blockdb_field "$_row" alias)"
    _cur_ip="$(blockdb_field "$_row" ip)"
    _cur_user="$(blockdb_field "$_row" user)"
    _cur_port="$(blockdb_field "$_row" port)"
    [ -n "$_cur_port" ] || _cur_port=22

    printf '\nEditing device: %s\n' "$_alias" >&2
    _new_alias="$(_prompt_field "alias"  "$_cur_alias")"
    _new_ip="$(_prompt_field    "ip"     "$_cur_ip")"
    _new_user="$(_prompt_field  "user"   "$_cur_user")"
    _new_port="$(_prompt_field  "port"   "$_cur_port")"

    # If IP changed, clean known_hosts of old IP before reconnecting
    known_hosts_sync_device "$_cur_alias" "$_cur_ip" "$_new_ip"

    _new_block="$(printf 'alias: %s\nip: %s\nuser: %s\nport: %s\n' \
        "$_new_alias" "$_new_ip" "$_new_user" "$_new_port")"
    if [ "$_new_alias" != "$_cur_alias" ]; then
        blockdb_remove "$DB" alias "$_cur_alias"
    fi
    blockdb_upsert "$DB" alias "$_new_alias" "$_new_block"
    log OK "updated '$_alias' → alias=$_new_alias ip=$_new_ip user=$_new_user port=$_new_port"
}

_cmd_rename() {
    [ $# -ge 2 ] || { printf 'usage: ndevs --rename <old> <new>\n' >&2; exit 1; }
    _old="$1"; _new="$2"
    _require_db
    _alias_exists "$_old" || { log ERROR "unknown alias: '$_old'"; exit 1; }

    _row="$(_find_alias "$_old")"
    _new_block="$(printf '%s\n' "$_row" | awk -v na="$_new" '
        /^alias:/ { print "alias: " na; next }
        { print }
    ')"
    blockdb_remove "$DB" alias "$_old"
    blockdb_upsert "$DB" alias "$_new" "$_new_block"
    log OK "renamed '$_old' → '$_new'"
}

_cmd_remove() {
    [ $# -ge 1 ] || { printf 'usage: ndevs --remove <alias> [alias...]\n' >&2; exit 1; }
    _require_db

    for _alias in "$@"; do
        _row="$(_find_alias "$_alias")"
        if [ -z "$_row" ]; then
            log WARN "unknown alias: '$_alias' — skipping"
            continue
        fi
        _ip="$(blockdb_field "$_row" ip)"

        blockdb_remove "$DB" alias "$_alias"

        known_hosts_remove_ip "$_ip"
        log OK "removed '$_alias' ($_ip) and cleaned known_hosts"
    done
}

_cmd_resetall() {
    rm -f "$DB" "$DATA/state/hosts.db" "$DATA/state/cache.env" "$KNOWN_HOSTS"
    : > "$DB"
    log OK "reset complete: devices.db + known_hosts + hosts.db + cache cleared"
}

_cmd_update_ip() {
    [ $# -ge 2 ] || { printf 'usage: ndevs --update-ip <alias> <newip>\n' >&2; exit 1; }
    _alias="$1"; _new_ip="$2"
    _require_db

    _row="$(_find_alias "$_alias")"
    [ -n "$_row" ] || { log ERROR "unknown alias: '$_alias'"; exit 1; }
    _old_ip="$(blockdb_field "$_row" ip)"
    _row_user="$(blockdb_field "$_row" user)"
    _row_port="$(blockdb_field "$_row" port)"

    # snapshot before write so --rollback can restore
    _snap="$(_snapshot_db "$_alias")"

    known_hosts_sync_device "$_alias" "$_old_ip" "$_new_ip"

    _new_block="$(printf 'alias: %s\nip: %s\nuser: %s\nport: %s\n' \
        "$_alias" "$_new_ip" "$_row_user" "$_row_port")"
    blockdb_upsert "$DB" alias "$_alias" "$_new_block"
    log OK "updated '$_alias': ip $_old_ip → $_new_ip"

    if reachable_ssh "$_new_ip" "$_row_port"; then
        log OK "ssh check: $_new_ip reachable"
    else
        log WARN "ssh check: $_new_ip not reachable — entry kept; rollback with: ndevs --rollback $_alias"
    fi

    _propagate_db "$_new_ip"
}


_cmd_add() {
    [ $# -ge 3 ] || { printf 'usage: ndevs --add <alias> <ip> <user> [port]\n' >&2; exit 1; }
    _alias="$1"; _ip="$2"; _user="$3"; _port="${4:-22}"
    if [ -f "$DB" ] && [ -n "$(blockdb_get "$DB" alias "$_alias")" ]; then
        log ERROR "alias '$_alias' already exists — use --edit or --rename"; exit 1
    fi

    # snapshot before any write so --rollback can restore
    _snap="$(_snapshot_db "$_alias")"

    _add_block="$(printf 'alias: %s\nip: %s\nuser: %s\nport: %s\n' "$_alias" "$_ip" "$_user" "$_port")"
    blockdb_upsert "$DB" alias "$_alias" "$_add_block"
    log OK "registered '$_alias' ip=$_ip user=$_user port=$_port"

    # verify SSH reachability; the entry stays persistent either way
    if reachable_ssh "$_ip" "$_port"; then
        log OK "ssh check: $_ip:$_port reachable"
    else
        log WARN "ssh check: $_ip:$_port not reachable — entry kept; rollback with: ndevs --rollback $_alias"
    fi

    _propagate_db "$_ip"
}

# _propagate_db skip_ip — push devices.db to every registered LAN node
# (non-Tailscale IP) via nscp, skipping skip_ip and self. Best-effort:
# a node that is down is warned, never fatal. Explicit Tailscale propagation
# is done by --push-vpn, never automatically here.
_propagate_db() {
    _skip_ip="${1:-}"
    [ -f "$DB" ] || return 0
    has_cmd nscp || { log WARN "nscp not found — skipping db propagation"; return 0; }
    _remote_path="$HOME/.local/share/noemap/state/devices.db"
    _pd_aliases="$(awk '
        BEGIN { RS=""; FS="\n" }
        {
            for (i = 1; i <= NF; i++) {
                colon = index($i, ":")
                if (colon == 0) continue
                fk = substr($i, 1, colon - 1)
                if (fk == "alias") { print substr($i, colon + 2); break }
            }
        }
    ' "$DB" 2>/dev/null)"
    printf '%s\n' "$_pd_aliases" | while IFS= read -r _pa; do
        [ -n "$_pa" ] || continue
        _pblk="$(blockdb_get "$DB" alias "$_pa")"
        [ -n "$_pblk" ] || continue
        _pip="$(blockdb_field "$_pblk" ip)"
        _pport="$(blockdb_field "$_pblk" port)"
        [ -n "$_pport" ] || _pport=22
        [ "$_pip" = "$_skip_ip" ] && continue
        case "$_pip" in 100.*) continue ;; esac
        if ! reachable_ssh "$_pip" "$_pport"; then
            log WARN "propagate to $_pa skipped (unreachable: $_pip:$_pport)"
            continue
        fi
        if nscp "$DB" "${_pa}:${_remote_path}" >/dev/null 2>&1; then
            log OK "propagated devices.db -> $_pa"
        else
            log WARN "propagate to $_pa failed (node down?) — skipped"
        fi
    done
}

# _cmd_rollback alias — restore devices.db from the user-state snapshot.
_cmd_rollback() {
    [ $# -ge 1 ] || { printf 'usage: ndevs --rollback <alias>\n' >&2; exit 1; }
    _alias="$1"
    _snap_path="$DATA/state/snapshots/${_alias}.bak"
    [ -f "$_snap_path" ] || { log ERROR "no snapshot for '$_alias' at $_snap_path"; exit 1; }
    cp -f "$_snap_path" "$DB"
    log OK "rolled back devices.db from snapshot '$_alias'"
}

# _cmd_push_vpn — propagate devices.db to all Tailscale (100.*) nodes via nscp.
# Explicit command, never automatic.
_cmd_push_vpn() {
    _require_db
    has_cmd nscp || { log ERROR "nscp not found"; exit 1; }
    _remote_path="$HOME/.local/share/noemap/state/devices.db"
    _pv_aliases="$(awk '
        BEGIN { RS=""; FS="\n" }
        {
            for (i = 1; i <= NF; i++) {
                colon = index($i, ":")
                if (colon == 0) continue
                fk = substr($i, 1, colon - 1)
                if (fk == "alias") { print substr($i, colon + 2); break }
            }
        }
    ' "$DB" 2>/dev/null)"
    printf '%s\n' "$_pv_aliases" | while IFS= read -r _pa; do
        [ -n "$_pa" ] || continue
        _pblk="$(blockdb_get "$DB" alias "$_pa")"
        [ -n "$_pblk" ] || continue
        _pip="$(blockdb_field "$_pblk" ip)"
        _pport="$(blockdb_field "$_pblk" port)"
        [ -n "$_pport" ] || _pport=22
        case "$_pip" in 100.*) ;; *) continue ;; esac
        if ! reachable_ssh "$_pip" "$_pport"; then
            log WARN "push to $_pa skipped (unreachable: $_pip:$_pport)"
            continue
        fi
        if nscp "$DB" "${_pa}:${_remote_path}" >/dev/null 2>&1; then
            log OK "pushed devices.db -> $_pa ($_pip)"
        else
            log WARN "push to $_pa ($_pip) failed — skipped"
        fi
    done
}

# _distribute_registry -- push registry.db to every known node via nssh,
# skipping self. Called after every registry change so identity is never stale.
# Fix noemap#407: the per-node loop runs in a pipe (subshell), so failures
# cannot set a variable visible to this function directly. Failures are
# counted in a temp file instead, read back after the pipe completes, so
# the function returns a real, non-zero status when at least one reachable
# node failed to receive the registry (unreachable nodes are skipped, not
# counted as failures).
_distribute_registry() {
    [ -f "$REGISTRY_DB" ] || return 0
    has_cmd nssh || { log WARN "nssh not found -- registry not distributed"; return 0; }
    _remote_reg="$HOME/.local/share/noemap/state/registry.db"
    [ -f "$DB" ] || return 0
    # Skip self by local IP (MY_IP if exported, else any 127.* / own row).
    _my_alias="$(node_alias 2>/dev/null || printf '')"
    _dr_fail_count="$(mktemp "${TMPDIR:-/tmp}/distribute-registry-fails.XXXXXX")"
    _dr_aliases="$(awk '
        BEGIN { RS=""; FS="\n" }
        {
            for (i = 1; i <= NF; i++) {
                colon = index($i, ":")
                if (colon == 0) continue
                fk = substr($i, 1, colon - 1)
                if (fk == "alias") { print substr($i, colon + 2); break }
            }
        }
    ' "$DB" 2>/dev/null)"
    printf '%s\n' "$_dr_aliases" | while IFS= read -r _na; do
        [ -n "$_na" ] || continue
        [ "$_na" = "$_my_alias" ] && continue
        _nblk="$(blockdb_get "$DB" alias "$_na")"
        [ -n "$_nblk" ] || continue
        _nip="$(blockdb_field "$_nblk" ip)"
        _nport="$(blockdb_field "$_nblk" port)"
        [ -n "$_nport" ] || _nport=22
        if command -v is_local_ip >/dev/null 2>&1 && is_local_ip "$_nip"; then continue; fi
        case "$_nip" in 127.*|localhost) continue ;; esac
        if ! reachable_ssh "$_nip" "$_nport"; then
            log WARN "registry -> $_na skipped (unreachable: $_nip:$_nport)"
            continue
        fi
        if nssh "$_na" "mkdir -p ~/.local/share/noemap/state && cat > $_remote_reg" < "$REGISTRY_DB" >/dev/null 2>&1; then
            log OK "registry -> $_na"
        else
            log WARN "registry to $_na failed (node down?) -- skipped"
            printf 'x' >> "$_dr_fail_count"
        fi
    done
    _dr_fails="$(wc -c < "$_dr_fail_count" 2>/dev/null || printf 0)"
    rm -f "$_dr_fail_count"
    [ "${_dr_fails:-0}" -eq 0 ]
}

# _registry_default_dir -- working tree of the git-backed registry repo.
_registry_default_dir() { printf '%s\n' "$HOME/.noemap-registry"; }

# _registry_commit_and_push -- if REGISTRY_DB is the default git-backed path
# and that repo is cloned, commit the current registry.db to a throwaway
# branch, push it, merge to main, push main, then delete the branch (local +
# remote). Mirrors the manual flow already validated for this repo. Runs
# best-effort: any git step failing warns and returns, never aborts the
# caller (identity is already saved locally by the time this runs).
# Fix noemap#407: explicit return so callers (_cmd_node_set) can detect
# a real git-sync failure instead of always seeing success.
_registry_commit_and_push() {
    _rc_dir="$(_registry_default_dir)"
    [ "$REGISTRY_DB" = "$_rc_dir/registry.db" ] || return 0
    [ -d "$_rc_dir/.git" ] || { log WARN "registry repo not cloned at $_rc_dir -- skipping git commit"; return 0; }

    _rc_branch="sync/$(date +%Y%m%d%H%M%S)-$(node_id 2>/dev/null || printf 'node')"

    ( cd "$_rc_dir" || exit 1
      git fetch origin >/dev/null 2>&1
      git checkout main >/dev/null 2>&1 || git checkout -b main >/dev/null 2>&1
      git pull --rebase origin main >/dev/null 2>&1
      if git diff --quiet -- registry.db && git diff --cached --quiet -- registry.db; then
          exit 0
      fi
      git checkout -b "$_rc_branch" >/dev/null 2>&1 || exit 1
      git add registry.db
      git commit -m "chore: sync registry.db ($(node_id 2>/dev/null))" >/dev/null 2>&1 || exit 1
      git push -u origin "$_rc_branch" >/dev/null 2>&1 || exit 1
      git checkout main >/dev/null 2>&1 || exit 1
      git merge --no-edit "$_rc_branch" >/dev/null 2>&1 || exit 1
      git push origin main >/dev/null 2>&1 || exit 1
      git branch -d "$_rc_branch" >/dev/null 2>&1
      git push origin --delete "$_rc_branch" >/dev/null 2>&1
    )
    _rc_status=$?
    if [ "$_rc_status" -eq 0 ]; then
        log OK "registry.db committed + pushed to noemap-registry (main)"
        return 0
    else
        log WARN "registry.db git sync failed -- resolve manually in $_rc_dir"
        return 1
    fi
}

# _cmd_node_set -- set THIS device's canonical identity in the master registry.
# usage: ndevs --node-set <alias> [user] [port]
# Fix noemap#407: the local blockdb_upsert always succeeds (it's a plain
# file write), but the previous code reported "log OK" unconditionally
# right after it, before knowing whether the registry.db change actually
# reached git (_registry_commit_and_push) or the other nodes
# (_distribute_registry). Both those functions now return a real exit
# status; this command captures both and only reports full success when
# both succeeded, otherwise a WARN naming exactly which step failed.
_cmd_node_set() {
    [ $# -ge 1 ] || { printf 'usage: ndevs --node-set <alias> [user] [port]\n' >&2; exit 1; }
    _alias="$1"
    # Default user is 'u' (Android user name is irrelevant). If not passed and
    # stdin is a tty, prompt with 'u' as the suggested default (Enter accepts).
    if [ -n "${2:-}" ]; then
        _user="$2"
    elif [ -t 0 ]; then
        printf '  user [u]: ' >&2
        read -r _user </dev/tty || _user=""
        [ -n "$_user" ] || _user="u"
    else
        _user="u"
    fi
    _port="${3:-8022}"
    _nid="$(node_id)"
    [ -n "$_nid" ] || { log ERROR "could not compute node id"; exit 1; }
    mkdir -p "$(dirname "$REGISTRY_DB")"
    [ -f "$REGISTRY_DB" ] || : > "$REGISTRY_DB"
    _ns_block="$(printf 'node_id: %s\nalias: %s\nuser: %s\nport: %s\n' "$_nid" "$_alias" "$_user" "$_port")"
    blockdb_upsert "$REGISTRY_DB" node_id "$_nid" "$_ns_block"

    _ns_commit_ok=1
    _registry_commit_and_push || _ns_commit_ok=0
    _ns_distribute_ok=1
    _distribute_registry || _ns_distribute_ok=0

    if [ "$_ns_commit_ok" -eq 1 ] && [ "$_ns_distribute_ok" -eq 1 ]; then
        log OK "node identity set: $_alias ($_nid) user=$_user port=$_port"
    else
        log WARN "node identity saved locally: $_alias ($_nid) user=$_user port=$_port -- $([ "$_ns_commit_ok" -eq 0 ] && printf 'registry git sync failed' )$([ "$_ns_commit_ok" -eq 0 ] && [ "$_ns_distribute_ok" -eq 0 ] && printf '; ')$([ "$_ns_distribute_ok" -eq 0 ] && printf 'node distribution incomplete')"
    fi
}

# _cmd_node_add -- register ANOTHER machine's identity by explicit node-id.
# usage: ndevs --node-add <node-id> <alias> <user> <port>
_cmd_node_add() {
    [ $# -ge 4 ] || { printf 'usage: ndevs --node-add <node-id> <alias> <user> <port>\n' >&2; exit 1; }
    _nid="$1"; _alias="$2"; _user="$3"; _port="$4"
    mkdir -p "$(dirname "$REGISTRY_DB")"
    [ -f "$REGISTRY_DB" ] || : > "$REGISTRY_DB"
    if [ -n "$(blockdb_get "$REGISTRY_DB" node_id "$_nid")" ]; then
        log ERROR "node-id '$_nid' already registered -- use --node-set semantics or edit"; exit 1
    fi
    _na_block="$(printf 'node_id: %s\nalias: %s\nuser: %s\nport: %s\n' "$_nid" "$_alias" "$_user" "$_port")"
    blockdb_upsert "$REGISTRY_DB" node_id "$_nid" "$_na_block"
    log OK "node added: $_alias ($_nid) user=$_user port=$_port"
    _distribute_registry
}

# _cmd_nodes -- list the master registry, marking which row is THIS device.
_cmd_nodes() {
    [ -f "$REGISTRY_DB" ] && [ -s "$REGISTRY_DB" ] || { log INFO "no nodes registered (use --node-set)"; return 0; }
    _me="$(node_id 2>/dev/null || printf '')"
    printf '  NODE-ID           ALIAS      USER       PORT  SELF\n'
    _cn_nids="$(awk '
        BEGIN { RS=""; FS="\n" }
        {
            for (i = 1; i <= NF; i++) {
                colon = index($i, ":")
                if (colon == 0) continue
                fk = substr($i, 1, colon - 1)
                if (fk == "node_id") { print substr($i, colon + 2); break }
            }
        }
    ' "$REGISTRY_DB" 2>/dev/null)"
    printf '%s\n' "$_cn_nids" | while IFS= read -r _cnid; do
        [ -n "$_cnid" ] || continue
        _cblk="$(blockdb_get "$REGISTRY_DB" node_id "$_cnid")"
        [ -n "$_cblk" ] || continue
        _calias="$(blockdb_field "$_cblk" alias)"
        _cuser="$(blockdb_field "$_cblk" user)"
        _cport="$(blockdb_field "$_cblk" port)"
        printf "  %-16s  %-9s  %-9s  %-4s  %s\n" "$_cnid" "$_calias" "$_cuser" "$_cport" "$([ "$_cnid" = "$_me" ] && printf -- '<-- this')"
    done
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
    "")                   _cmd_list ;;
    --add)                shift; _cmd_add "$@" ;;
    --edit)               shift; _cmd_edit "$@" ;;
    --rename)             shift; _cmd_rename "$@" ;;
    --remove)             shift; _cmd_remove "$@" ;;
    --update-ip)          shift; _cmd_update_ip "$@" ;;
    --rollback)           shift; _cmd_rollback "$@" ;;
    --push-vpn)           shift; _cmd_push_vpn "$@" ;;
    --node-set)           shift; _cmd_node_set "$@" ;;
    --node-add)           shift; _cmd_node_add "$@" ;;
    --nodes)              _cmd_nodes ;;
    --resetall)           _cmd_resetall ;;
    -h|--help)
        printf 'usage: ndevs\n'
        printf '       ndevs --edit <alias>\n'
        printf '       ndevs --rename <old> <new>\n'
        printf '       ndevs --remove <alias> [alias...]\n'
        printf '       ndevs --update-ip <alias> <newip>\n'
        printf '       ndevs --add <alias> <ip> <user> [port]\n'
        printf '       ndevs --rollback <alias>\n'
        printf '       ndevs --push-vpn <alias>\n'
        printf '       ndevs --node-set <alias> [user] [port]\n'
        printf '       ndevs --node-add <node-id> <alias> <user> <port>\n'
        printf '       ndevs --nodes\n'
        printf '       ndevs --resetall\n'
        ;;
    *)
        printf '[ERROR] unknown option: %s\n' "$1" >&2
        exit 1
        ;;
esac
