#!/usr/bin/env bash
# nclip-listen — manage the noemap clipboard forward listener
#
# Listens on a local Unix socket and pipes received data into the
# local clipboard (termux-clipboard-set / pbcopy / wl-copy).
# The socket is exposed to SSH servers via RemoteForward so that
# clipso on the server can mirror to this client's clipboard.
#
# Usage:
#   nclip-listen start    start listener in background (no-op if running)
#   nclip-listen stop     stop listener
#   nclip-listen restart  stop + start
#   nclip-listen status   show running state and socket path
#
# Environment:
#   NOEMAP_BASE            override project root
#   CLIP_FORWARD_SOCK      override socket path (default: ~/.noemap-clip.sock)

set -eu

_self="$0"
case "$_self" in */*) ;; *) _self="$(command -v "$_self")" ;; esac
if _real="$(readlink -f "$_self" 2>/dev/null)" && [ -n "$_real" ]; then
    _self="$_real"
else
    while [ -L "$_self" ]; do
        _link="$(readlink "$_self")"
        case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
    done
fi
_bindir="$(cd "$(dirname "$_self")" && pwd -P)"
. "$_bindir/_bootstrap"
BASE="$DATA"

SOCK="${CLIP_FORWARD_SOCK:-$HOME/.noemap-clip.sock}"
TCP_PORT="${CLIP_TCP_PORT:-9988}"
CLIP_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/clipso/last"

# ── detect local clipboard ────────────────────────────────────────────────────
_clip_cmd=""
if command -v termux-clipboard-set >/dev/null 2>&1; then
    _clip_cmd="termux-clipboard-set"
elif command -v pbcopy >/dev/null 2>&1; then
    _clip_cmd="pbcopy"
elif command -v wl-copy >/dev/null 2>&1; then
    _clip_cmd="wl-copy"
else
    printf '[ERROR] no clipboard tool found (termux-clipboard-set / pbcopy / wl-copy)\n' >&2
    exit 1
fi

# ── helpers ───────────────────────────────────────────────────────────────────
_is_running() {
    tmux has-session -t nclip-listen 2>/dev/null
}

_do_start() {
    if _is_running; then
        printf '[INFO]  nclip-listen already running (tmux session nclip-listen)\n' >&2
        return 0
    fi
    rm -f "$SOCK"
    mkdir -p "$(dirname "$CLIP_CACHE")"
    _loop='while true; do
        _tmp_clip="${TMPDIR:-/tmp}/nclip-recv.$$"
        python3 -c "
import socket,sys
p=sys.argv[1];o=sys.argv[2]
s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET,socket.SO_RCVBUF,524288)
s.bind(p);s.listen(1)
c,_=s.accept();d=b\"\"
while True:
    chunk=c.recv(65536)
    if not chunk:break
    d+=chunk
c.close();s.close()
open(o,\"wb\").write(d)
" "$SOCK" "$_tmp_clip" 2>/dev/null || true
        if [ -s "$_tmp_clip" ]; then
            cp "$_tmp_clip" "$CLIP_CACHE"
            CLIP_ENV=termux "$_bindir/play-confirm.sh" 2>/dev/null || true
            setsid "$_clip_cmd" < "$_tmp_clip" 2>/dev/null || "$_clip_cmd" < "$_tmp_clip" || true
        fi
        rm -f "$_tmp_clip"
    done'
    _inner="export SOCK=$(printf %q "$SOCK") CLIP_CACHE=$(printf %q "$CLIP_CACHE") _clip_cmd=$(printf %q "$_clip_cmd") _bindir=$(printf %q "$_bindir"); ${_loop}"
    tmux new-session -d -s nclip-listen "$_inner"
    printf '[OK]    nclip-listen started (tmux session nclip-listen, sock %s)\n' "$SOCK" >&2
}

_do_foreground() {
    # Run the accept-loop in the foreground; for launchd/systemd KeepAlive.
    rm -f "$SOCK"
    mkdir -p "$(dirname "$CLIP_CACHE")"
    _tmp_clip="${TMPDIR:-/tmp}/nclip-recv.$$"
    while true; do
        python3 -c '
import socket,sys
p=sys.argv[1];o=sys.argv[2]
s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET,socket.SO_RCVBUF,524288)
s.bind(p);s.listen(1)
c,_=s.accept();d=b""
while True:
    chunk=c.recv(65536)
    if not chunk:break
    d+=chunk
c.close();s.close()
open(o,"wb").write(d)
' "$SOCK" "$_tmp_clip" 2>/dev/null || true
        if [ -s "$_tmp_clip" ]; then
            cp "$_tmp_clip" "$CLIP_CACHE"
            CLIP_ENV=termux "$_bindir/play-confirm.sh" 2>/dev/null || true
            "$_clip_cmd" < "$_tmp_clip" || true
        fi
        rm -f "$_tmp_clip"
    done
}

_do_stop() {
    if ! _is_running; then
        printf '[INFO]  nclip-listen not running\n' >&2
        rm -f "$SOCK"
        return 0
    fi
    tmux kill-session -t nclip-listen 2>/dev/null || true
    rm -f "$SOCK"
    printf '[OK]    nclip-listen stopped (tmux session nclip-listen)\n' >&2
}

_do_status() {
    if _is_running; then
        printf '[OK]    running  tmux session=nclip-listen  sock=%s\n' "$SOCK" >&2
        [ -S "$SOCK" ] && printf '[OK]    socket exists\n' >&2 \
                       || printf '[WARN]  socket missing — RemoteForward not active?\n' >&2
    else
        printf '[INFO]  not running\n' >&2
    fi
}

# ── dispatch ──────────────────────────────────────────────────────────────────
_tcp_is_running() {
    tmux has-session -t nclip-listen-tcp 2>/dev/null
}

_tcp_start() {
    if ! command -v ncat >/dev/null 2>&1; then
        printf '[ERROR] ncat not found  TCP mode requires ncat\n' >&2
        return 1
    fi
    if _tcp_is_running; then
        printf '[INFO]  nclip-listen TCP already running (tmux session nclip-listen-tcp)\n' >&2
        return 0
    fi
    mkdir -p "$(dirname "$CLIP_CACHE")"
    _tcp_loop='while true; do
        _tcp_tmp="${TMPDIR:-/tmp}/nclip-tcp-recv.$$"
        ncat -l 0.0.0.0 $TCP_PORT > "$_tcp_tmp" 2>/dev/null || true
        if [ -s "$_tcp_tmp" ]; then
            cp "$_tcp_tmp" "$CLIP_CACHE"
            CLIP_ENV=termux "$_bindir/play-confirm.sh" 2>/dev/null || true
            setsid "$_clip_cmd" < "$_tcp_tmp" 2>/dev/null || "$_clip_cmd" < "$_tcp_tmp" || true
        fi
        rm -f "$_tcp_tmp"
    done'
    _tcp_inner="export TCP_PORT=$(printf %q "$TCP_PORT") CLIP_CACHE=$(printf %q "$CLIP_CACHE") _clip_cmd=$(printf %q "$_clip_cmd") _bindir=$(printf %q "$_bindir"); ${_tcp_loop}"
    tmux new-session -d -s nclip-listen-tcp "$_tcp_inner"
    printf '[OK]    nclip-listen TCP started (tmux session nclip-listen-tcp, port %s)\n' "$TCP_PORT" >&2
}

_tcp_stop() {
    if ! _tcp_is_running; then
        printf '[INFO]  nclip-listen TCP not running\n' >&2
        return 0
    fi
    tmux kill-session -t nclip-listen-tcp 2>/dev/null || true
    pkill -f "ncat -l $TCP_PORT" 2>/dev/null || true
    printf '[OK]    nclip-listen TCP stopped (tmux session nclip-listen-tcp)\n' >&2
}

_tcp_status() {
    if _tcp_is_running; then
        printf '[OK]    TCP running  tmux session=nclip-listen-tcp  port=%s\n' "$TCP_PORT" >&2
    else
        printf '[INFO]  TCP not running\n' >&2
    fi
}

case "${1:-}" in
    start)   _do_start  ;;
    start-tcp)   _tcp_start  ;;
    stop-tcp)    _tcp_stop   ;;
    restart-tcp) _tcp_stop; _tcp_start ;;
    status-tcp)  _tcp_status ;;
    foreground) _do_foreground ;;
    stop)    _do_stop   ;;
    restart) _do_stop; _do_start ;;
    status)  _do_status ;;
    -h|--help)
        printf 'usage: nclip-listen <start|stop|restart|status|foreground>\n'
        printf '       nclip-listen <start-tcp|stop-tcp|restart-tcp|status-tcp>\n'
        exit 0
        ;;
    *)
        printf 'usage: nclip-listen <start|stop|restart|status|foreground>\n' >&2
        exit 1
        ;;
esac
