#!/bin/sh
# _bootstrap — shared self/data resolution, sourced by bin/* tools.
# Not installed as a tool (install.sh excludes this name explicitly).
#
# Resolves the calling script's real path, then DATA/LIB/DB/CFG under the
# standalone-copy model (installer dir -> default -> repo). Exports BASE
# so lib/util.sh's log() can find logs/. Caller sources this, then calls
# _source_mods with its own module list.
#
# Usage (from a bin/* tool, after `set -eu`):
#   . "$(dirname "$0")/_bootstrap" 2>/dev/null || . "$_bindir_fallback/_bootstrap"
#   _source_mods util.sh devices.sh

_self="$0"
case "$_self" in */*) ;; *) _self="$(command -v "$_self")" ;; esac
if _real="$(readlink -f "$_self" 2>/dev/null)" && [ -n "$_real" ]; then
    _self="$_real"
else
    while [ -L "$_self" ]; do
        _link="$(readlink "$_self")"
        case "$_link" in /*) _self="$_link" ;; *) _self="$(dirname "$_self")/$_link" ;; esac
    done
fi
_bindir="$(cd "$(dirname "$_self")" && pwd -P)"

# Lib/data resolution (standalone-copy model): installer dir, then default, then repo.
_repo_base="${NOEMAP_BASE:-$(dirname "$_bindir")}"
if [ -n "${NOEMAP_DATA:-}" ] && [ -d "${NOEMAP_DATA}/lib" ]; then
    DATA="$NOEMAP_DATA"
elif [ -d "$HOME/.local/share/noemap/lib" ]; then
    DATA="$HOME/.local/share/noemap"
else
    DATA="$_repo_base"
fi
LIB="$DATA/lib"
DB="$DATA/state/devices.db"
CFG="$DATA/config/ssh_config"
export BASE="$DATA"

# _source_mods mod.sh... — sources each module from LIB; missing = fatal.
_source_mods() {
    for _mod in "$@"; do
        _path="$LIB/$_mod"
        if [ ! -f "$_path" ]; then
            printf '[ERROR] missing module: %s\n' "$_mod" >&2
            exit 1
        fi
        # shellcheck source=/dev/null
        . "$_path"
    done
}
